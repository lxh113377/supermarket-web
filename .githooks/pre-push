#!/bin/sh
# CI 全绿契约（第二十三轮接线）：推 main 之前，先确认远端 CI 对本次 HEAD 是 GREEN。
# 为什么必须是硬闸而不是"记得看一眼"：d1RoundTrips 缺 @vitest-environment node 让 CI 连红
# 7 个 commit、deploy 被 needs 掐住，而三份对标报告都写着"CI 全绿"——本地绿与 CI 绿可以
# 同时不成立，所以唯一凭据是远端回执。四态里 UNKNOWN/BLOCKED 一律判红（裸静音判红）。
# 逃生门：CI_GREEN_SKIP=1 且必须同时给 CI_GREEN_REASON="..."，否则照样拒。
set -e
# 第三十九轮 R39-H1：提交面自足（链引用的脚本必须在提交面里解得出、也必须被 git 跟踪）。
# 立它的实测：本轮开场实测到上一轮的 10 件在途工作里，package.json/ci.yml 已把
# verify:restore-drill 与 check:live-shape 接进链路，而这两个脚本文件都还没入库 ——
# CI 只看提交面、本地 43 个判据只看磁盘面，两者从不比对，所以"本地全绿"与"这提交必红"同时成立。
# 为什么只能挂在 push 而不是 CI：未跟踪文件在 CI 的检出里根本不存在，那一半判据在 CI 恒绿=假绿。
# 逃生门与下面同规格：HEAD_CLOSURE_SKIP=1 必须同时给 HEAD_CLOSURE_REASON，否则照样拒。
if [ "$HEAD_CLOSURE_SKIP" = "1" ]; then
  if [ -z "$HEAD_CLOSURE_REASON" ]; then
    echo "[pre-push] head-closure 被跳过却没给 HEAD_CLOSURE_REASON ⇒ 跳过要留名，拒推" >&2
    exit 1
  fi
  echo "[pre-push] head-closure 豁免放行：$HEAD_CLOSURE_REASON" >&2
  node scripts/check-head-closure.mjs || true
else
  node scripts/check-head-closure.mjs
fi
if [ "$CI_GREEN_SKIP" = "1" ]; then
  node scripts/ci-green-contract.mjs "$@" && exit 0
  exit 1
fi
node scripts/ci-green-contract.mjs "$@"
