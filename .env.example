# 超柿 - 环境变量配置
# 复制此文件为 .env 并填入实际值

# CloudBase 环境 ID（必填）
VITE_CB_ENV_ID=chaoshi-xxxxxxxxxxxxx

# 云函数 HTTP 访问服务端点（必填，在 CloudBase 控制台 - 云函数 - HTTP 访问服务 中获取）
VITE_CB_API_BASE=https://your-env-id.ap-shanghai.tcb-api.tencentcloud.com/admin-api
VITE_CB_PUBLIC_API_BASE=https://your-env-id.ap-shanghai.tcb-api.tencentcloud.com/public-api

# 管理后台密钥（云函数侧配置，前端不直接使用）
# 在 CloudBase 控制台 - 云函数 - 环境变量 中设置：
# ADMIN_KEY=your-secret-key-here
# ENV_ID=your-env-id-here
