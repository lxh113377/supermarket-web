{
  "name": "supermarket-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run lint",
    "build": "vite build",
    "lint": "oxlint --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.backend.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:stub": "playwright test --config playwright.stub.config.ts",
    "smoke": "node scripts/smoke-deploy.mjs",
    "uptime": "node scripts/uptime-check.mjs",
    "ci:status": "node scripts/ci-status.mjs",
    "verify:backend": "node scripts/verify-backend.mjs",
    "preview": "vite preview",
    "build:stub": "vite build --config vite.config.stub.js --outDir dist-stub --mode stub",
    "serve:stub": "node scripts/local-api-stub.mjs --dir dist-stub --port 5182",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "check:cycles": "node scripts/check-import-cycles.mjs",
    "gen:api-contract": "node scripts/api-contract.mjs --write",
    "verify:contract": "node scripts/api-contract.mjs",
    "docs:api": "node scripts/gen-api-doc.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "verify:functions": "node scripts/check-functions-build.mjs",
    "verify:docs": "node scripts/check-doc-consistency.mjs",
    "verify:case": "node scripts/check-case-collision.mjs",
    "verify:images": "python scripts/verify_images.py",
    "verify:schema": "node scripts/check-schema-drift.mjs",
    "migrate": "node scripts/migrate.mjs",
    "audit:deps": "npm audit --registry=https://registry.npmjs.org --audit-level=high",
    "maintain:purge-events": "node scripts/purge-security-events.mjs",
    "verify": "npm run scan:secrets && npm run lint && npm run verify:case && npm run check:cycles && npm run verify:contract && npm run verify:docs && npm run verify:schema && npm run verify:licenses && npm run verify:changelog && npm run typecheck && npm test && npm run verify:backend && npm run verify:functions && node scripts/list-uncovered.mjs",
    "test:coverage": "vitest run --coverage",
    "verify:licenses": "node scripts/check-licenses.mjs",
    "verify:changelog": "node scripts/check-changelog.mjs"
  },
  "dependencies": {
    "echarts": "^5.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.85.0",
    "postcss": "^8.5.22",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.137.0"
  }
}
