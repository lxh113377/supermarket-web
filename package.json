{
  "name": "supermarket-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run lint",
    "build": "vite build",
    "lint": "oxlint --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.backend.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:stub": "playwright test --config playwright.stub.config.ts",
    "smoke": "node scripts/smoke-deploy.mjs",
    "verify:parity": "node scripts/verify-release-parity.mjs",
    "uptime": "node scripts/uptime-check.mjs",
    "ci:status": "node scripts/ci-status.mjs",
    "verify:backend": "node scripts/verify-backend.mjs",
    "preview": "vite preview",
    "build:stub": "vite build --config vite.config.stub.js --outDir dist-stub --mode stub",
    "serve:stub": "node scripts/local-api-stub.mjs --dir dist-stub --port 5182",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "check:cycles": "node scripts/check-import-cycles.mjs",
    "gen:api-contract": "node scripts/api-contract.mjs --write",
    "verify:contract": "node scripts/api-contract.mjs",
    "docs:api": "node scripts/gen-api-doc.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "verify:functions": "node scripts/check-functions-build.mjs",
    "verify:docs": "node scripts/check-doc-consistency.mjs",
    "verify:case": "node scripts/check-case-collision.mjs",
    "verify:env": "node scripts/check-env-docs.mjs",
    "verify:csp": "node scripts/check-csp-static.mjs",
    "verify:restore": "node scripts/verify-backup-restore.mjs",
    "verify:restore-drill": "node scripts/restore-drill.mjs",
    "backup:decrypt": "node scripts/backup-crypto.mjs --decrypt",
    "backup:verify": "node scripts/backup-crypto.mjs --verify",
    "report:pr-tests": "node scripts/check-pr-has-tests.mjs",
    "report:catalog": "node scripts/check-catalog-facts.mjs",
    "check:backup-liveness": "node scripts/check-backup-liveness.mjs",
    "check:cron-health": "node scripts/check-cron-health.mjs",
    "check:live-shape": "node scripts/check-live-shape.mjs",
    "verify:images": "python scripts/verify_images.py",
    "verify:schema": "node scripts/check-schema-drift.mjs",
    "verify:migrate-replay": "node scripts/verify-migrate-replay.mjs",
    "verify:roundtrips": "node scripts/check-d1-roundtrips.mjs",
    "verify:authz": "node scripts/check-action-authz.mjs",
    "verify:limits": "node scripts/check-limit-provenance.mjs",
    "verify:errors": "node scripts/check-error-semantics.mjs",
    "verify:pii": "node scripts/check-pii-inventory.mjs",
    "verify:entrypoints": "node scripts/check-cli-entrypoints.mjs",
    "migrate": "node scripts/migrate.mjs",
    "audit:deps": "npm audit --registry=https://registry.npmjs.org --audit-level=high",
    "maintain:purge-events": "node scripts/purge-security-events.mjs",
    "verify": "npm run scan:secrets && npm run lint && npm run verify:case && npm run verify:env && npm run verify:csp && npm run check:cycles && npm run verify:contract && npm run verify:response && npm run verify:registry && npm run verify:docs && npm run check:doc-commands && npm run verify:schema && npm run verify:migrate-replay && npm run verify:roundtrips && npm run verify:authz && npm run verify:limits && npm run verify:errors && npm run verify:pii && npm run verify:entrypoints && npm run verify:restore-drill && npm run verify:licenses && npm run verify:volume && npm run verify:pointers && npm run verify:changelog && npm run typecheck && npm test && npm run verify:backend && npm run verify:functions && node scripts/list-uncovered.mjs",
    "test:coverage": "vitest run --coverage",
    "verify:licenses": "node scripts/check-licenses.mjs",
    "verify:changelog": "node scripts/check-changelog.mjs",
    "verify:response": "node scripts/api-response-contract.mjs",
    "verify:registry": "node scripts/check-registry-sync.mjs",
    "verify:pointers": "node scripts/check-memory-pointer-sync.mjs",
    "gen:response-contract": "node scripts/api-response-contract.mjs --write",
    "verify:volume": "node scripts/check-memory-volume.mjs --all",
    "report:branch-protection": "node scripts/check-branch-protection.mjs",
    "report:d1-usage": "node scripts/check-d1-remote-usage.mjs",
    "check:doc-commands": "node scripts/check-doc-commands.mjs",
    "check:judge-side-effects": "node scripts/check-judge-side-effects.mjs"
  },
  "dependencies": {
    "echarts": "^5.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.85.0",
    "postcss": "^8.5.22",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.137.0"
  }
}
